rules_version = '2';

// Template. Paste into Firebase console › Firestore › Rules, replacing REPLACE_WITH_TRIP_KEY
// with your trip key. Never commit the real key: anyone with it can read and edit the trip.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripKey}/{document=**} {
      allow read, write: if request.auth != null && tripKey == 'REPLACE_WITH_TRIP_KEY';
    }
  }
}
